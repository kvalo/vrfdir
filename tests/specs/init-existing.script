#!/bin/sh
# SPDX-FileCopyrightText: 2026 Kalle Valo
# SPDX-License-Identifier: GPL-3.0-or-later
#
# init must not overwrite an existing repository, the cases which
# depend on the system are in tests/specs-unix and tests/specs-windows

# don't 'set -e' on purpose so that we can verify the exit value from
# the init command

cd "$DATADIR" || exit 1

"$SRCDIR/vrfdir" init
echo aaaa > a
"$SRCDIR/vrfdir" add --quiet a

echo init again
"$SRCDIR/vrfdir" init
retval=$?

if [ $retval != 3 ]; then
    echo Wrong exit value: $retval
fi

echo vrfdir list
"$SRCDIR/vrfdir" list

echo .vrfdir is a file
rm -fr .vrfdir
echo foobar > .vrfdir
"$SRCDIR/vrfdir" init
retval=$?

if [ $retval != 3 ]; then
    echo Wrong exit value: $retval
fi

# cleanup
rm -fr .vrfdir a
