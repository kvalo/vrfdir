#!/bin/sh
# SPDX-FileCopyrightText: 2026 Kalle Valo
# SPDX-License-Identifier: GPL-3.0-or-later
#
# test the commands without a repository

# don't 'set -e' on purpose so that we can verify the exit values

cd "$DATADIR" || exit 1

echo test without .vrfdir directory
echo aaaa > a

for cmd in status check list export info 'add a'; do
    # shellcheck disable=SC2086
    "$SRCDIR/vrfdir" $cmd 2> /dev/null
    retval=$?

    if [ $retval != 3 ]; then
        echo "$cmd: Wrong exit value: $retval"
    fi
done

# the error message
"$SRCDIR/vrfdir" status

# cleanup
rm -fr .vrfdir a
