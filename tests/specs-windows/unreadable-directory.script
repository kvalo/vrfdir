#!/bin/sh
# SPDX-FileCopyrightText: 2026 Kalle Valo
# SPDX-License-Identifier: GPL-3.0-or-later
#
# test that a directory which cannot be read is an error in every
# command which goes through the directories, and that the files in
# it are not shown as deleted, the Windows version of
# tests/specs-unix/unreadable-directory

# Windows has no chmod for this, take the right away from the user with
# a deny entry. MSYS2_ARG_CONV_EXCL keeps the sh of Git for Windows from
# changing /deny to a path.
deny() {
    MSYS2_ARG_CONV_EXCL='*' icacls "$1" /deny "$USERNAME:($2)" > /dev/null
}

allow() {
    MSYS2_ARG_CONV_EXCL='*' icacls "$1" /remove:d "$USERNAME" > /dev/null
}

# don't 'set -e' on purpose so that we can verify the exit values

cd "$DATADIR" || exit 1

run() {
    echo "vrfdir $*"
    "$SRCDIR/vrfdir" "$@"
    retval=$?

    if [ $retval != 3 ]; then
        echo Wrong exit value: $retval
    fi
}

"$SRCDIR/vrfdir" init
mkdir -p dir/sub locked
echo aaaa > a
echo bbbb > dir/sub/b
echo cccc > locked/c
"$SRCDIR/vrfdir" add --quiet a locked

# a is a difference, the error still wins
echo aaaaaaaa > a
deny locked RD

run status
run check --quiet
run scan

# the files elsewhere are still added
run add --quiet .
echo vrfdir list
"$SRCDIR/vrfdir" list | sort

# the directory given to add itself
run add --quiet locked

# cleanup
allow locked
rm -fr .vrfdir a dir locked
