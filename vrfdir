HELP_SCAN = '''\
Go through all the files below the current directory and print the
ones whose name is not valid in the encoding of the locale, each on
its own line after the letter E. The last line is the number of the
files which were found. A name with a newline is escaped, see
'vrfdir --help'.

vrfdir works with such names, but many other programs do not. scan
does not need a repository and does not change anything.

A directory which cannot be read is an error, the rest is still
scanned.

exit codes:
  0    the scan was done, also when such names were found
  3    error: a directory could not be read
  64   wrong command line
  130  interrupted
'''


# argparse exits with 2 on a wrong command line, which is corruption
# here. The parsers of the commands are of this class as well.
class VrfdirArgumentParser(argparse.ArgumentParser):

    # the message in the same format as the others
    def error(self, message):
        self.print_usage(sys.stderr)
        self.exit(EXIT_USAGE, 'Error: %s\nRun \'%s --help\' for the '
                  'instructions.\n' % (message, self.prog))


# Python flushes stdout once more when it exits. After a write to it
# has failed give it something which does not fail, otherwise Python
# prints its own message and exits with 120.
def discard_stdout():
    devnull = os.open(os.devnull, os.O_WRONLY)
    os.dup2(devnull, sys.stdout.fileno())


def run_command():
    raw = argparse.RawDescriptionHelpFormatter

    parser = VrfdirArgumentParser(
        formatter_class=raw, description=HELP_MAIN,
        epilog='Run \'%(prog)s COMMAND --help\' for the details of a '
        'command.')
    parser.add_argument('-d', '--debug', action='store_true',
                        help='print debug messages to stderr')
    parser.add_argument('--version', action='version',
                        version='%(prog)s ' + version_string(),
                        help='print the version and exit')
    subparsers = parser.add_subparsers(title='commands', metavar='COMMAND',
                                       dest='command', required=True)

    parser_init = subparsers.add_parser(
        'init', formatter_class=raw, description=HELP_INIT,
        help='create an empty repository in the current directory')
    parser_init.set_defaults(func=cmd_init)

    parser_add = subparsers.add_parser(
        'add', formatter_class=raw, description=HELP_ADD,
        help='add files, or all files below a directory')
    parser_add.add_argument('-q', '--quiet', action='store_true',
                            help='do not show the progress meter')
    parser_add.add_argument('files', metavar='FILE', nargs='+',
                            help='file to add, or a directory to add all '
                            'files below it')
    parser_add.set_defaults(func=cmd_add)

    parser_status = subparsers.add_parser(
        'status', formatter_class=raw, description=HELP_STATUS,
        help='show the changed, deleted and not added files')
    parser_status.set_defaults(func=cmd_status)

    parser_check = subparsers.add_parser(
        'check', formatter_class=raw, description=HELP_CHECK,
        help='verify the checksums of all added files')
    parser_check.add_argument('-q', '--quiet', action='store_true',
                              help='do not show the progress meter')
    parser_check.set_defaults(func=cmd_check)

    parser_list = subparsers.add_parser(
        'list', formatter_class=raw, description=HELP_LIST,
        help='print the checksum, size and name of the added files')
    parser_list.set_defaults(func=cmd_list)

    parser_export = subparsers.add_parser(
        'export', formatter_class=raw, description=HELP_EXPORT,
        help='print the checksums in the format of sha256sum')
    parser_export.set_defaults(func=cmd_export)

    parser_upgrade = subparsers.add_parser(
        'upgrade', formatter_class=raw, description=HELP_UPGRADE,
        help='upgrade the repository to the latest format')
    parser_upgrade.add_argument('-q', '--quiet', action='store_true',
                                help='do not show the progress meter')
    parser_upgrade.set_defaults(func=cmd_upgrade)

    parser_info = subparsers.add_parser(
        'info', formatter_class=raw, description=HELP_INFO,
        help='show information about the repository')
    parser_info.add_argument('-m', '--machine-readable', action='store_true',
                             help='print exact values as key=value lines')
    parser_info.set_defaults(func=cmd_info)

    parser_scan = subparsers.add_parser(
        'scan', formatter_class=raw, description=HELP_SCAN,
        help='find file names which are not valid in the encoding of the '
        'locale')
    parser_scan.set_defaults(func=cmd_scan)

    args = parser.parse_args()

    if args.debug:
        logger.setLevel(logging.DEBUG)

    # Write the file names as the bytes they have on the disk, also
    # the names which are not valid in the encoding of the locale. On
    # Windows this is UTF-8. Do not write the newline as '\r\n' there
    # so that the output is the same on every system.
    sys.stdout.reconfigure(encoding=sys.getfilesystemencoding(),
                           errors=sys.getfilesystemencodeerrors(),
                           newline='\n')

    logger.debug('filesystem encoding: %s', sys.getfilesystemencoding())

    args.func(args)


def main():
    global logger

    # Python sets these to None when the program is started with
    # stdout or stderr closed.
    if sys.stdout is None:
        sys.stdout = open(os.devnull, 'w')

    if sys.stderr is None:
        sys.stderr = open(os.devnull, 'w')

    # the messages are 'Error: cannot do foo'
    logging.addLevelName(logging.ERROR, 'Error')
    logging.addLevelName(logging.WARNING, 'Warning')
    logging.addLevelName(logging.DEBUG, 'Debug')

    logger = logging.getLogger('vrfdir')
    logging.basicConfig(format='%(levelname)s: %(message)s', stream=sys.stderr)

    # no stacktrace from logging when writing a message fails
    logging.raiseExceptions = False

    # Parse the command line and call the function of the command.
    # What a command does not handle itself ends here, so that the
    # exit code is never the 1 of a Python stacktrace, which means
    # differences. Also argparse is inside the try, it prints the help
    # to stdout.
    try:
        try:
            run_command()
        finally:
            # here, also when the command exits, so that a failure to
            # write the output is noticed
            sys.stdout.flush()
    except KeyboardInterrupt:
        logger.error('interrupted')
        sys.exit(EXIT_INTERRUPTED)
    except BrokenPipeError:
        # the reader of the output, for example head, has exited
        discard_stdout()
        sys.exit(EXIT_ERROR)
    except OSError as e:
        # The commands handle the files themselves, what gets here
        # without a file name is a failed write to stdout.
        if e.filename is None:
            logger.error('cannot write the output: %s' % error_reason(e))
        else:
            logger.error('cannot access %s: %s' % (e.filename,
                                                   error_reason(e)))

        discard_stdout()
        sys.exit(EXIT_ERROR)
    except Exception:
        # a bug, keep the stacktrace for the report
        logger.exception('internal error, this is a bug in vrfdir')
        sys.exit(EXIT_ERROR)


if __name__ == "__main__":
    main()
