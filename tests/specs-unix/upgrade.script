#!/bin/sh
# SPDX-FileCopyrightText: 2026 Kalle Valo
# SPDX-License-Identifier: GPL-3.0-or-later
#
# test vrfdir upgrade with a file and a directory which cannot be read,
# made so with chmod. The rest is in tests/specs.
#
# Note: the unreadable file needs a normal user, which ./check makes
# sure of.
#
# don't 'set -e' on purpose so that we can verify the exit values

cd "$DATADIR" || exit 1

# write a manifest.json of format version 1, which has only MD5
# checksums, for the files. A file name must not need escaping.
make_v1() {
    sep=''
    printf '[{"version": 1, "files": {' > .vrfdir/manifest.json
    for f in "$@"; do
        sum=$(md5sum "$f" | cut -d' ' -f1)
        size=$(wc -c < "$f" | tr -d ' ')
        printf '%s"%s": {"md5sum": "%s", "size": %d}' "$sep" "$f" "$sum" \
            "$size" >> .vrfdir/manifest.json
        sep=', '
    done
    printf '}}]\n' >> .vrfdir/manifest.json
}

echo aaaa > a
echo bbbb > b
mkdir .vrfdir dir
echo cccc > dir/c
: > empty

echo a file which cannot be read is an error and the others are upgraded
make_v1 a b dir/c empty
chmod 000 b
"$SRCDIR/vrfdir" upgrade --quiet
echo "exit value: $?"
"$SRCDIR/vrfdir" list
chmod 644 b

echo
echo corruption is more important than an error
make_v1 a b dir/c empty
echo xxxx > a
chmod 000 b
"$SRCDIR/vrfdir" upgrade --quiet
echo "exit value: $?"
chmod 644 b
echo aaaa > a

echo
echo a directory which cannot be read is an error, its files are not upgraded
make_v1 a dir/c
chmod 000 dir
"$SRCDIR/vrfdir" upgrade --quiet
echo "exit value: $?"
chmod 755 dir
"$SRCDIR/vrfdir" list

# cleanup
rm -fr .vrfdir a b dir empty
