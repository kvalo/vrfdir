#!/bin/sh
# SPDX-FileCopyrightText: 2026 Kalle Valo
# SPDX-License-Identifier: GPL-3.0-or-later
#
# test that only regular files are handled: a link to a file is
# followed, a dangling link and a named pipe are not files. The rest is
# in tests/specs.

set -e

cd "$DATADIR"

"$SRCDIR/vrfdir" init

mkdir dir
echo aaaa > dir/a
ln -s no-such-file dir/dangling
ln -s a dir/link-to-a
mkfifo dir/fifo

"$SRCDIR/vrfdir" add --quiet .

echo vrfdir list
"$SRCDIR/vrfdir" list | sort

echo vrfdir status
"$SRCDIR/vrfdir" status

echo vrfdir check
"$SRCDIR/vrfdir" check --quiet

# cleanup
rm -fr .vrfdir dir
