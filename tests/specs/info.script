#
# test info command

set -e

cd "$DATADIR"

# create simple repo
"$SRCDIR/vrfdir" init
echo aaaa > a
echo bbbb > b
echo cccc > c
"$SRCDIR/vrfdir" add --quiet a b c

"$SRCDIR/vrfdir" info
"$SRCDIR/vrfdir" info --machine-readable

# cleanup
rm -fr .vrfdir a b c
