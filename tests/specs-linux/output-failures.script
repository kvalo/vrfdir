#!/bin/sh
# SPDX-FileCopyrightText: 2026 Kalle Valo
# SPDX-License-Identifier: GPL-3.0-or-later
#
# test that a failure to write the output is an error with the
# documented exit value, not a Python stacktrace. A closed stdout and
# stderr are in tests/specs.

# don't 'set -e' on purpose so that we can verify the exit values

cd "$DATADIR" || exit 1

# run vrfdir with the given arguments, the caller redirects stdout
check_exit() {
    expected=$1
    shift

    "$SRCDIR/vrfdir" "$@" 2> stderr.txt
    retval=$?

    if [ $retval != "$expected" ]; then
        echo "Wrong exit value: $retval" >&2
    fi

    # what Python prints by itself
    grep -e Traceback -e 'Exception ignored' stderr.txt >&2
}

"$SRCDIR/vrfdir" init
echo aaaa > a
"$SRCDIR/vrfdir" add --quiet a

echo disk full >&2
check_exit 3 list > /dev/full
cat stderr.txt >&2
check_exit 3 scan > /dev/full
check_exit 3 --help > /dev/full

# The reader has exited, no message as with head. The sleep is to be
# sure that it has exited before vrfdir writes.
echo broken pipe >&2
{ sleep 0.2; check_exit 3 list; } | true
cat stderr.txt >&2
{ sleep 0.2; check_exit 3 --help; } | true

# cleanup
rm -fr .vrfdir a stderr.txt
