#!/bin/sh
# SPDX-FileCopyrightText: 2026 Kalle Valo
# SPDX-License-Identifier: GPL-3.0-or-later
#
# init must not overwrite an existing repository, the Windows version
# of tests/specs-unix/init-existing: a directory where .vrfdir cannot be
# created. The rest is in tests/specs.

# Windows has no chmod for this, take the right away from the user with
# a deny entry. MSYS2_ARG_CONV_EXCL keeps the sh of Git for Windows from
# changing /deny to a path.
deny() {
    MSYS2_ARG_CONV_EXCL='*' icacls "$1" /deny "$USERNAME:($2)" > /dev/null
}

allow() {
    MSYS2_ARG_CONV_EXCL='*' icacls "$1" /remove:d "$USERNAME" > /dev/null
}

# don't 'set -e' on purpose so that we can verify the exit value from
# the init command

cd "$DATADIR" || exit 1

echo no permission to the directory
mkdir locked
deny locked AD
(cd locked && "$SRCDIR/vrfdir" init)
retval=$?

if [ $retval != 3 ]; then
    echo Wrong exit value: $retval
fi

# cleanup
allow locked
rm -fr locked
