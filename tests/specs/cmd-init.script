#
# init empty directory and run few commands

set -e

cd "$DATADIR"

echo .vrfdir without manifest.json
mkdir .vrfdir
"$SRCDIR/vrfdir" init
echo

echo vrfdir status
"$SRCDIR/vrfdir" status
echo

# cleanup
rm -fr .vrfdir
