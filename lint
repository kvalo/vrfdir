# Run linters. Requires flake8, shellcheck and mdl (markdownlint).

set -eu

flake8 vrfdir tests/genbackupdata tests/benchmark tests/sigint-at tests/inject-at \
    tests/unit/*.py

shellcheck check coverage lint unit tests/specs/*.script

mdl README.md TODO.md CLAUDE.md CHANGELOG.md

echo "lint: ok"
