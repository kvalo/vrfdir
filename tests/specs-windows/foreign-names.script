#!/bin/sh
# SPDX-FileCopyrightText: 2026 Kalle Valo
# SPDX-License-Identifier: GPL-3.0-or-later
#
# test the entries of manifest.json whose name cannot be a file name on
# Windows, from a repository made on another system. They are kept as
# they are: status shows them as deleted, check, add and refresh do not
# touch them, and the next save writes them back unchanged, so that the
# repository still works on the system where the files were added.

# don't 'set -e' on purpose so that we can verify the exit values

cd "$DATADIR" || exit 1

mkdir .vrfdir
echo aaaa > a
echo bbbb > b

# version 2 has no checksum of the content, so it can be written here
cat > .vrfdir/manifest.json << 'EOF'
[{"version": 2, "files": {
"a": {"checksum": "sha256:11a77c3d96c06974b53d7f40a577e6813739eb5c811b2a86f59038ea90add772", "size": 5},
"a:b": {"checksum": "sha256:11a77c3d96c06974b53d7f40a577e6813739eb5c811b2a86f59038ea90add772", "size": 5},
"back\\slash": {"checksum": "sha256:11a77c3d96c06974b53d7f40a577e6813739eb5c811b2a86f59038ea90add772", "size": 5},
"bad-\udcff-name": {"checksum": "sha256:11a77c3d96c06974b53d7f40a577e6813739eb5c811b2a86f59038ea90add772", "size": 5},
"con.txt": {"checksum": "sha256:11a77c3d96c06974b53d7f40a577e6813739eb5c811b2a86f59038ea90add772", "size": 5},
"dir/nul": {"checksum": "sha256:11a77c3d96c06974b53d7f40a577e6813739eb5c811b2a86f59038ea90add772", "size": 5},
"x.": {"checksum": "sha256:11a77c3d96c06974b53d7f40a577e6813739eb5c811b2a86f59038ea90add772", "size": 5}
}}]
EOF

echo vrfdir status
"$SRCDIR/vrfdir" status
echo "exit value: $?"

echo vrfdir check
"$SRCDIR/vrfdir" check --quiet
echo "exit value: $?"

echo add another file
"$SRCDIR/vrfdir" add --quiet b
echo "exit value: $?"

echo vrfdir list
"$SRCDIR/vrfdir" list

echo the names in the new manifest.json
grep -o '"[^"]*": {"checksum"' .vrfdir/manifest.json | LC_ALL=C sort

echo refresh does not remove them
rm a
"$SRCDIR/vrfdir" refresh --quiet .
echo "exit value: $?"
"$SRCDIR/vrfdir" list

echo a directory with only them has no added files for refresh
"$SRCDIR/vrfdir" refresh --quiet dir
echo "exit value: $?"

# A foreign file cannot be read here, so upgrade cannot replace its
# MD5 checksum. It upgrades the rest and tells where to upgrade it.
echo a repository with an MD5 checksum of a foreign name
rm -r .vrfdir
mkdir .vrfdir
echo aaaa > a
cat > .vrfdir/manifest.json << 'EOF'
[{"version": 2, "files": {
"a": {"checksum": "md5:e5828c564f71fea3a12dde8bd5d27063", "size": 5},
"a:b": {"checksum": "md5:e5828c564f71fea3a12dde8bd5d27063", "size": 5}
}}]
EOF

echo vrfdir info
"$SRCDIR/vrfdir" info
echo "exit value: $?"

echo vrfdir upgrade
"$SRCDIR/vrfdir" upgrade --quiet
echo "exit value: $?"

echo vrfdir list
"$SRCDIR/vrfdir" list

# cleanup
rm -fr .vrfdir a b
