#!/bin/sh
# SPDX-FileCopyrightText: 2026 Kalle Valo
# SPDX-License-Identifier: GPL-3.0-or-later
#
# test that a broken manifest.json is reported as an error, the Windows
# version of tests/specs-unix/manifest-json-failures. The rest is in
# tests/specs.

# don't 'set -e' on purpose so that we can verify the exit values

cd "$DATADIR" || exit 1

check_status() {
    "$SRCDIR/vrfdir" status
    retval=$?

    if [ $retval != 3 ]; then
        echo Wrong exit value: $retval
    fi
}

mkdir .vrfdir

echo manifest.json is a directory
mkdir .vrfdir/manifest.json
check_status
rmdir .vrfdir/manifest.json

# Written by older versions for a name with a backslash. The name is
# not a file name on Windows, but the entry is converted the same.
echo backslash before the checksum
cat > .vrfdir/manifest.json << 'EOF'
[{"version": 1, "files": {"back\\slash": {"md5sum": "\\e5828c564f71fea3a12dde8bd5d27063", "size": 5}}}]
EOF
"$SRCDIR/vrfdir" check --quiet
echo "exit value: $?"
"$SRCDIR/vrfdir" list

# cleanup
rm -fr .vrfdir
