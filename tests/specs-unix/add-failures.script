#!/bin/sh
# SPDX-FileCopyrightText: 2026 Kalle Valo
# SPDX-License-Identifier: GPL-3.0-or-later
#
# test paths which the add command must refuse, the ones which need a
# POSIX system: /dev/null, a named pipe, the error texts and a
# directory without permissions. The rest is in tests/specs.

# don't 'set -e' on purpose so that we can verify the exit values

cd "$DATADIR" || exit 1

try_add() {
    "$SRCDIR/vrfdir" add --quiet "$@"
    retval=$?

    if [ $retval != 3 ]; then
        echo Wrong exit value: $retval
    fi
}

"$SRCDIR/vrfdir" init
echo aaaa > a
mkfifo fifo

echo absolute path
try_add /dev/null

echo fifo
try_add fifo

echo file as a directory
try_add a/b

# Note: this does not work as root, which has the permission anyway.
echo no permission to the directory
mkdir locked
echo bbbb > locked/b
chmod 000 locked
try_add locked/b
chmod 755 locked

echo vrfdir list
"$SRCDIR/vrfdir" list

# cleanup
rm -fr .vrfdir a fifo locked
