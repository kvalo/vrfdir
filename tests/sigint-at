#
# Run a script and send a real SIGINT to it, as Ctrl-C does, when it
# hashes its Nth file. This is deterministic, so that the tests of the
# interrupt handling do not depend on timing.
#
# usage: sigint-at N SCRIPT [ARGS...]

import hashlib
import os
import runpy
import signal
import sys

EXIT_HOOK_NOT_REACHED = 70


def main():
    if len(sys.argv) < 3:
        print('usage: sigint-at N SCRIPT [ARGS...]', file=sys.stderr)
        sys.exit(64)

    n = int(sys.argv[1])
    script = sys.argv[2]
    sys.argv = sys.argv[2:]

    file_digest = hashlib.file_digest
    count = 0

    # vrfdir hashes a file only with this
    def hooked_file_digest(*args, **kwargs):
        nonlocal count
        count += 1
        if count == n:
            # not os.kill(), which kills the process on Windows
            signal.raise_signal(signal.SIGINT)
        return file_digest(*args, **kwargs)

    hashlib.file_digest = hooked_file_digest

    try:
        runpy.run_path(script, run_name='__main__')
    finally:
        # a hook which never fired would make the test pass for the
        # wrong reason
        if count < n:
            print('sigint-at: %s hashed only %d file(s), not %d' %
                  (os.path.basename(script), count, n), file=sys.stderr)
            os._exit(EXIT_HOOK_NOT_REACHED)


if __name__ == "__main__":
    main()
