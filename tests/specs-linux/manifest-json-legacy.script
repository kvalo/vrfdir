#!/bin/sh
# SPDX-FileCopyrightText: 2026 Kalle Valo
# SPDX-License-Identifier: GPL-3.0-or-later
#
# test the old name of manifest.json, hashes.json, when it cannot be
# removed, with the error text of Linux. The rest is in tests/specs.

# don't 'set -e' on purpose so that we can verify the exit values

cd "$DATADIR" || exit 1

echo aaaa > a
echo bbbb > b

echo the old file cannot be removed
"$SRCDIR/vrfdir" init
"$SRCDIR/vrfdir" add --quiet a
mkdir .vrfdir/hashes.json
"$SRCDIR/vrfdir" add --quiet b
echo "exit value: $?"
ls .vrfdir
"$SRCDIR/vrfdir" list

# cleanup
rm -fr .vrfdir a b
