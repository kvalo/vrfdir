#!/bin/sh
# SPDX-FileCopyrightText: 2026 Kalle Valo
# SPDX-License-Identifier: GPL-3.0-or-later
#
# test names with a space, a leading dash and a character which is not
# ASCII in a subdirectory. The names which cannot be files on Windows
# are in tests/specs-unix.

set -e

cd "$DATADIR"

# create simple repo
"$SRCDIR/vrfdir" init

echo "test space"
file_space='space foo'
echo 1234567890 > "$file_space"
"$SRCDIR/vrfdir" add --quiet "$file_space"
echo

# the md5sum command would take the name as an option
echo "test leading dash"
file_dash='-dash'
echo 3333333333 > "./$file_dash"
"$SRCDIR/vrfdir" add --quiet "./$file_dash"
echo

echo "test utf-8 character in subdir"
utf8_subdir='utf-8/'
mkdir -p "$utf8_subdir"
file_utf8_subdir=$utf8_subdir$(printf 'KEV\303\204TJUHLA')
echo 2222222222 > "$file_utf8_subdir"
"$SRCDIR/vrfdir" add --quiet utf-8
echo

echo vrfdir info
"$SRCDIR/vrfdir" info
echo

echo vrfdir list
"$SRCDIR/vrfdir" list
echo

echo vrfdir status
"$SRCDIR/vrfdir" status
echo

echo vrfdir check
"$SRCDIR/vrfdir" check --quiet
echo

# cleanup
rm -fr .vrfdir "$file_space" "./$file_dash" "$utf8_subdir"
