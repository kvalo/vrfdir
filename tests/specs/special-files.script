#!/bin/sh
# SPDX-FileCopyrightText: 2026 Kalle Valo
# SPDX-License-Identifier: GPL-3.0-or-later
#
# test that only the .vrfdir directory itself is ignored. The links and
# a named pipe are in tests/specs-unix.

set -e

cd "$DATADIR"

"$SRCDIR/vrfdir" init

mkdir dir
echo aaaa > dir/a
echo bbbb > .vrfdir-notes
mkdir .vrfdirs
echo cccc > .vrfdirs/c

# a file given twice is added once
"$SRCDIR/vrfdir" add --quiet . dir dir/a

echo vrfdir list
"$SRCDIR/vrfdir" list | sort

echo vrfdir status
"$SRCDIR/vrfdir" status

echo vrfdir check
"$SRCDIR/vrfdir" check --quiet

# cleanup
rm -fr .vrfdir dir .vrfdir-notes .vrfdirs
