#!/bin/bash
# SPDX-FileCopyrightText: 2026 Kalle Valo
# SPDX-License-Identifier: GPL-3.0-or-later
#
# test the exact content of manifest.json which vrfdir writes for the
# names which cannot be files on every system: a backslash, a tab and a
# byte which is not valid UTF-8. The rest is in tests/specs.
#
# Note: this script must use bash, not dash, to be able to correctly
# create weird filenames!
#
# don't 'set -e' on purpose so that we can verify the exit values

cd "$DATADIR" || exit 1

"$SRCDIR/vrfdir" init

echo bbbb > 'back\slash'
echo dddd > "$(printf 'iso8859-1: \xc4')"
echo eeee > "$(printf 'tab:\tname')"
echo add
"$SRCDIR/vrfdir" add --quiet 'back\slash' "$(printf 'iso8859-1: \xc4')" \
    "$(printf 'tab:\tname')"
cat .vrfdir/manifest.json

# json.dumps() has to escape everything, also a byte which is not
# valid UTF-8
echo only ASCII, one line
if LC_ALL=C grep -q '[^ -~]' .vrfdir/manifest.json; then
    echo manifest.json has other than printable ASCII
fi
echo "lines: $(wc -l < .vrfdir/manifest.json)"

# The old versions wrote the backslash which md5sum prints before the
# checksum of a name with a backslash. It is removed when the file is
# loaded and so it is gone when the file is written again.
echo the backslash before the checksum is removed on the next write
rm -fr .vrfdir
mkdir .vrfdir
cat > .vrfdir/manifest.json << 'JSON'
[{"version": 1, "files": {"back\\slash": {"md5sum": "\\4c7a5c6a43c8f3acf66b21e20b2ed2a9", "size": 5}}}]
JSON
echo ffff > f
"$SRCDIR/vrfdir" add --quiet f
cat .vrfdir/manifest.json

# cleanup
rm -fr .vrfdir 'back\slash' f "$(printf 'iso8859-1: \xc4')" \
   "$(printf 'tab:\tname')"
