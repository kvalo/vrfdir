set -e

# Several tests make a file unreadable with chmod, which has no effect
# on root. They would fail in confusing ways.
if [ "$(id -u)" = 0 ]; then
    echo "check: the tests do not work as root, run them as a normal user" >&2
    exit 1
fi

# tests/specs runs on every system, also on Windows with the sh of Git
# for Windows. tests/specs-unix needs a POSIX system (chmod, symbolic
# links, named pipes, the error texts), so it runs everywhere except on
# Windows. tests/specs-linux needs /dev/full, the error texts of Linux
# and names which are not valid UTF-8, and tests/specs-macos the
# behaviour of macOS, and tests/specs-windows the behaviour of Windows,
# so each runs only on its system.
# tests/specs-caseless needs a filesystem which ignores the case of the
# names, as macOS and Windows have by default. --portable runs only
# tests/specs.
portable=
n=$#
while [ "$n" -gt 0 ]; do
    if [ "$1" = "--portable" ]; then
        portable=1
        shift
    else
        set -- "$@" "$1"
        shift
    fi
    n=$((n - 1))
done

set -- "$@" tests/specs
if [ -z "$portable" ]; then
    case "$(uname -s)" in
        Linux) set -- "$@" tests/specs-unix tests/specs-linux ;;
        Darwin)
            set -- "$@" tests/specs-unix tests/specs-macos tests/specs-caseless
            ;;
        MINGW* | MSYS*)
            set -- "$@" tests/specs-windows tests/specs-caseless
            ;;
        *) set -- "$@" tests/specs-unix ;;
    esac
fi

cmdspecs "$@"
