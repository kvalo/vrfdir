#!/bin/bash
# SPDX-FileCopyrightText: 2026 Kalle Valo
# SPDX-License-Identifier: GPL-3.0-or-later
#
# test the order of the lines of status with a name which is not valid
# UTF-8. U+FF21 is the bytes EF BC A1 and comes before the byte FF. In a
# Python string the byte FF is U+DCFF, which is before U+FF21, so a sort
# of the strings would give the opposite order. The rest is in
# tests/specs.
#
# Note: this script must use bash, not dash, to be able to correctly
# create weird filenames!
#
# don't 'set -e' on purpose so that we can verify the exit value

cd "$DATADIR" || exit 1

"$SRCDIR/vrfdir" init

for name in a "$(printf '\xff')" "$(printf '\xef\xbc\xa1')"; do
    echo "$name" > "$name"
done

echo vrfdir status
# cat -v shows the byte which is not valid UTF-8
"$SRCDIR/vrfdir" status | cat -v
echo "exit value: ${PIPESTATUS[0]}"

# cleanup
rm -fr .vrfdir a "$(printf '\xff')" "$(printf '\xef\xbc\xa1')"
