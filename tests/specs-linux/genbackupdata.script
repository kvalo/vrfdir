#!/bin/sh
# SPDX-FileCopyrightText: 2026 Kalle Valo
# SPDX-License-Identifier: GPL-3.0-or-later
#
# test the errors of genbackupdata whose text comes from the system: a
# path which is a file, the directories without permissions and a full
# disk. The rest is in tests/specs.

set -e

cd "$DATADIR"

echo "Create test data in a path which is a file"
touch testfile
"$SRCDIR/tests/genbackupdata" --quiet --create 9M testfile 2>&1 ||
    echo "Failed with exit code $?"
echo

# ./check does not run as root, so the permissions are checked
echo "Create test data in a directory which is not writable:"
mkdir readonly
chmod 555 readonly
"$SRCDIR/tests/genbackupdata" --quiet --create 1k readonly 2>&1 ||
    true
"$SRCDIR/tests/genbackupdata" --quiet --create 1k readonly 2>/dev/null ||
    echo "Failed with exit code $?"
chmod 755 readonly
echo

echo "Create test data in a directory which cannot be read:"
mkdir unreadable
chmod 000 unreadable
"$SRCDIR/tests/genbackupdata" --quiet --create 1k unreadable 2>&1 ||
    echo "Failed with exit code $?"
chmod 755 unreadable
echo

# a failed write to stdout is an error and not a stacktrace
echo "Output to a full device:"
{ "$SRCDIR/tests/genbackupdata" --create 3k full > /dev/full; } 2>&1 ||
    echo "Failed with exit code $?"

# cleanup
rm -fr testfile readonly unreadable full
