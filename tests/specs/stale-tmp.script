#!/bin/sh
# SPDX-FileCopyrightText: 2026 Kalle Valo
# SPDX-License-Identifier: GPL-3.0-or-later
#
# test a manifest.json.tmp left behind by an interrupted write, and a
# write which fails

# don't 'set -e' on purpose so that we can verify the exit value from
# the add command

cd "$DATADIR" || exit 1

"$SRCDIR/vrfdir" init
echo aaaa > a
echo bbbb > b
"$SRCDIR/vrfdir" add --quiet a

echo stale file, list warns but works
echo garbage > .vrfdir/manifest.json.tmp
"$SRCDIR/vrfdir" list

echo next write replaces the stale file
"$SRCDIR/vrfdir" add --quiet b
ls .vrfdir
"$SRCDIR/vrfdir" list

echo write fails
echo cccc > c
mkdir .vrfdir/manifest.json.tmp
"$SRCDIR/vrfdir" add --quiet c
retval=$?

if [ $retval != 3 ]; then
    echo Wrong exit value: $retval
fi

echo manifest.json is not changed
rmdir .vrfdir/manifest.json.tmp
"$SRCDIR/vrfdir" list

# cleanup
rm -fr .vrfdir a b c
