set -e

# Several tests make a file unreadable with chmod, which has no effect
# on root. They would fail in confusing ways.
if [ "$(id -u)" = 0 ]; then
    echo "check: the tests do not work as root, run them as a normal user" >&2
    exit 1
fi

# tests/specs-linux needs names which are not valid UTF-8, names which
# differ only in the case, /dev/full and the error texts of Linux.
# macOS cannot do that, CI runs only tests/specs there.
portable=
n=$#
while [ "$n" -gt 0 ]; do
    if [ "$1" = "--portable" ]; then
        portable=1
        shift
    else
        set -- "$@" "$1"
        shift
    fi
    n=$((n - 1))
done

set -- "$@" tests/specs
if [ -z "$portable" ]; then
    set -- "$@" tests/specs-linux
fi

cmdspecs "$@"
