#!/bin/sh
# SPDX-FileCopyrightText: 2026 Kalle Valo
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Run the tests and print which lines of vrfdir they did not run.
# Arguments are the ones of ./check. Requires python3-coverage.
#
# --data-file FILE keeps the data of the run in FILE, for combining the
# data of several systems. When FILE exists, the data of this run is
# added to it.

set -eu

data_file=
n=$#
while [ "$n" -gt 0 ]; do
    if [ "$1" = "--data-file" ]; then
        if [ "$n" -lt 2 ]; then
            echo "coverage: --data-file needs a file name" >&2
            exit 64
        fi
        data_file=$2
        shift 2
        n=$((n - 2))
    else
        set -- "$@" "$1"
        shift
        n=$((n - 1))
    fi
done

if ! python3 -c 'import coverage' 2> /dev/null; then
    echo "coverage: the Python module coverage is missing" >&2
    exit 1
fi

# In the Git Bash of Windows the paths are MSYS paths (/d/a/...), but
# Python is a Windows program and coverage compares the paths which it
# gets with D:/a/... of Python. A list of paths in PYTHONPATH is
# separated with ; there.
case "$(uname -s)" in
    MINGW* | MSYS*)
        native() { cygpath -m "$1"; }
        sep=';'
        ;;
    *)
        native() { printf '%s\n' "$1"; }
        sep=':'
        ;;
esac

srcdir=$(cd "$(dirname "$0")" && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
rc=$(native "$tmp/rc")

# The tests run vrfdir as a new process many times, also through
# tests/sigint-at and tests/inject-at. Every Python process starts
# the measurement by itself with this, and writes its own data file.
mkdir "$tmp/site"
cat > "$tmp/site/sitecustomize.py" << 'PY'
import coverage
coverage.process_startup()
PY

cat > "$tmp/rc" << RC
[run]
parallel = True
data_file = $(native "$tmp/.coverage")
include = $(native "$srcdir/vrfdir")
# Where coverage has no compiled tracer, as on FreeBSD, every process
# would warn about it on stderr, which the tests compare.
disable_warnings = no-ctracer
RC

status=0
PYTHONPATH="$(native "$tmp/site")${PYTHONPATH:+$sep$PYTHONPATH}" \
    COVERAGE_PROCESS_START="$rc" "$srcdir/check" "$@" || status=$?

# the unit tests run vrfdir in their own process, not as a command
if python3 -c 'import pytest' 2> /dev/null; then
    python3 -B -m coverage run --rcfile="$rc" -m pytest \
        -p no:cacheprovider "$(native "$srcdir/tests/unit")" || status=$?
else
    echo "coverage: pytest is missing, the unit tests were not run" >&2
    status=1
fi

append=
if [ -n "$data_file" ] && [ -e "$data_file" ]; then
    cp "$data_file" "$tmp/.coverage"
    append=--append
fi
python3 -m coverage combine --rcfile="$rc" $append > /dev/null
python3 -m coverage report --rcfile="$rc" -m
if [ -n "$data_file" ]; then
    cp "$tmp/.coverage" "$data_file"
fi

exit $status
