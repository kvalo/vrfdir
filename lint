#
# Run linters. Requires flake8, shellcheck and mdl (markdownlint),
# yamllint is optional.

set -eu

flake8 vrfdir tests/genbackupdata tests/benchmark tests/sigint-at tests/inject-at \
    tests/unit/*.py

shellcheck check coverage lint unit tests/specs/*.script tests/specs-linux/*.script \
    tests/specs-macos/*.script

# yamllint is optional.
if command -v yamllint >/dev/null; then
    yamllint .github/workflows/*.yml
else
    echo "lint: yamllint not found, skipping workflow check"
fi

mdl README.md TODO.md CLAUDE.md CHANGELOG.md

echo "lint: ok"
