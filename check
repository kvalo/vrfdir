set -e

# Several tests make a file unreadable with chmod, which has no effect
# on root. They would fail in confusing ways.
if [ "$(id -u)" = 0 ]; then
    echo "check: the tests do not work as root, run them as a normal user" >&2
    exit 1
fi

# tests/specs-linux needs /dev/full, the error texts of Linux and names
# which are not valid UTF-8, and tests/specs-macos the behaviour of
# macOS, so each runs only on its system. The other systems run
# tests/specs. --portable runs only that on every system.
portable=
n=$#
while [ "$n" -gt 0 ]; do
    if [ "$1" = "--portable" ]; then
        portable=1
        shift
    else
        set -- "$@" "$1"
        shift
    fi
    n=$((n - 1))
done

set -- "$@" tests/specs
if [ -z "$portable" ]; then
    case "$(uname -s)" in
        Linux) set -- "$@" tests/specs-linux ;;
        Darwin) set -- "$@" tests/specs-macos ;;
        *) ;;
    esac
fi

cmdspecs "$@"
