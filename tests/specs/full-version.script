#!/bin/sh
# SPDX-FileCopyrightText: 2026 Kalle Valo
# SPDX-License-Identifier: GPL-3.0-or-later
#
# test that --full-version and -F print the version and the
# environment, and need no repository. The values depend on the
# machine, so only the labels are compared.

cd "$DATADIR" || exit 1

for opt in --full-version -F; do
    echo "--- $opt"
    "$SRCDIR/vrfdir" $opt > out.txt
    echo "exit value: $?"
    head -1 out.txt | grep -Eq '^vrfdir [0-9]+\.[0-9]+\.[0-9]+' \
        && echo "version printed"
    sed -n '/^Environment:/,$p' out.txt | sed 's/:.*//'
done

echo "--- --version has no environment"
"$SRCDIR/vrfdir" --version | grep -c Environment

if [ -e .vrfdir ]; then
    echo ".vrfdir exists"
fi

# cleanup
rm -f out.txt
