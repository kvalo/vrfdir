#!/bin/sh
# SPDX-FileCopyrightText: 2026 Kalle Valo
# SPDX-License-Identifier: GPL-3.0-or-later
#
# test that a file which cannot be read is reported by check as an
# error, not as modified, and does not prevent checking the other
# files, the Windows version of tests/specs-unix/check-unreadable

# Windows has no chmod for this, take the right away from the user with
# a deny entry. MSYS2_ARG_CONV_EXCL keeps the sh of Git for Windows from
# changing /deny to a path.
deny() {
    MSYS2_ARG_CONV_EXCL='*' icacls "$1" /deny "$USERNAME:($2)" > /dev/null
}

allow() {
    MSYS2_ARG_CONV_EXCL='*' icacls "$1" /remove:d "$USERNAME" > /dev/null
}

# don't 'set -e' on purpose so that we can verify the exit value from
# the check command

cd "$DATADIR" || exit 1

"$SRCDIR/vrfdir" init
echo aaaa > a
echo bbbb > b
echo cccc > c
"$SRCDIR/vrfdir" add --quiet a b c
deny b RD
echo dddd > c

"$SRCDIR/vrfdir" check --quiet
retval=$?

# corruption wins over the error
if [ $retval != 2 ]; then
    echo Wrong exit value: $retval
fi

echo check with only the unreadable file
echo cccc > c
"$SRCDIR/vrfdir" check --quiet
retval=$?

if [ $retval != 3 ]; then
    echo Wrong exit value: $retval
fi

# cleanup
allow b
rm -fr .vrfdir a b c
