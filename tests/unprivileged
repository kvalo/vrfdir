#
# Run a Python script without the backup and restore privileges of
# Windows, so that a deny entry of a directory has an effect. A process
# which has them enabled can list a directory and create in it whatever
# its permissions are, and the user of the CI runner, an administrator,
# has them enabled. A deny entry of a file works without this, open()
# does not use the privileges.
#
# The privileges are disabled in this process and the script inherits
# that. Where they are not enabled, as for a normal user, this changes
# nothing, and on the other systems this only runs the script. The exit
# value is the exit value of the script.
#
# A script and not any command, as Windows cannot start a script by
# its #! line. Like tests/locked.
#
# usage: unprivileged SCRIPT [ARGS...]

import subprocess
import sys

EXIT_USAGE = 64
EXIT_FAILED = 71

PRIVILEGES = ('SeBackupPrivilege', 'SeRestorePrivilege')

TOKEN_ADJUST_PRIVILEGES = 0x20
TOKEN_QUERY = 0x8


def disable_privileges():
    import ctypes
    from ctypes import wintypes

    class LUID(ctypes.Structure):
        _fields_ = [('LowPart', wintypes.DWORD), ('HighPart', wintypes.LONG)]

    class LUID_AND_ATTRIBUTES(ctypes.Structure):
        _fields_ = [('Luid', LUID), ('Attributes', wintypes.DWORD)]

    class TOKEN_PRIVILEGES(ctypes.Structure):
        _fields_ = [('PrivilegeCount', wintypes.DWORD),
                    ('Privileges', LUID_AND_ATTRIBUTES * len(PRIVILEGES))]

    advapi32 = ctypes.WinDLL('advapi32', use_last_error=True)
    kernel32 = ctypes.WinDLL('kernel32', use_last_error=True)
    kernel32.GetCurrentProcess.restype = wintypes.HANDLE
    advapi32.OpenProcessToken.argtypes = [
        wintypes.HANDLE, wintypes.DWORD, ctypes.POINTER(wintypes.HANDLE)]
    advapi32.LookupPrivilegeValueW.argtypes = [
        wintypes.LPCWSTR, wintypes.LPCWSTR, ctypes.POINTER(LUID)]
    advapi32.AdjustTokenPrivileges.argtypes = [
        wintypes.HANDLE, wintypes.BOOL, ctypes.POINTER(TOKEN_PRIVILEGES),
        wintypes.DWORD, ctypes.c_void_p, ctypes.c_void_p]

    def check(ok, what):
        if not ok:
            print('unprivileged: %s failed: %s' %
                  (what, ctypes.FormatError(ctypes.get_last_error())),
                  file=sys.stderr)
            sys.exit(EXIT_FAILED)

    token = wintypes.HANDLE()
    check(advapi32.OpenProcessToken(kernel32.GetCurrentProcess(),
                                    TOKEN_ADJUST_PRIVILEGES | TOKEN_QUERY,
                                    ctypes.byref(token)),
          'OpenProcessToken')

    tp = TOKEN_PRIVILEGES()
    tp.PrivilegeCount = len(PRIVILEGES)
    for (i, name) in enumerate(PRIVILEGES):
        check(advapi32.LookupPrivilegeValueW(
            None, name, ctypes.byref(tp.Privileges[i].Luid)),
            'LookupPrivilegeValueW')
        # 0 is disabled
        tp.Privileges[i].Attributes = 0

    # a privilege which the user does not have is not an error here
    check(advapi32.AdjustTokenPrivileges(token, False, ctypes.byref(tp), 0,
                                         None, None),
          'AdjustTokenPrivileges')
    kernel32.CloseHandle(token)


def main():
    if len(sys.argv) < 2:
        print('usage: unprivileged SCRIPT [ARGS...]', file=sys.stderr)
        sys.exit(EXIT_USAGE)

    if sys.platform == 'win32':
        disable_privileges()

    result = subprocess.run([sys.executable] + sys.argv[1:])
    sys.exit(result.returncode)


if __name__ == "__main__":
    main()
