#!/bin/sh
# SPDX-FileCopyrightText: 2026 Kalle Valo
# SPDX-License-Identifier: GPL-3.0-or-later
#
# init must not overwrite an existing repository

# don't 'set -e' on purpose so that we can verify the exit value from
# the init command

cd "$DATADIR" || exit 1

"$SRCDIR/vrfdir" init
echo aaaa > a
"$SRCDIR/vrfdir" add --quiet a

echo init again
"$SRCDIR/vrfdir" init
retval=$?

if [ $retval != 3 ]; then
    echo Wrong exit value: $retval
fi

echo vrfdir list
"$SRCDIR/vrfdir" list

echo .vrfdir is a file
rm -fr .vrfdir
echo foobar > .vrfdir
"$SRCDIR/vrfdir" init
retval=$?

if [ $retval != 3 ]; then
    echo Wrong exit value: $retval
fi

echo .vrfdir is a dangling symbolic link
rm -f .vrfdir
ln -s no-such-directory .vrfdir
"$SRCDIR/vrfdir" init
retval=$?

if [ $retval != 3 ]; then
    echo Wrong exit value: $retval
fi

# Note: this does not work as root, which can write anyway.
echo no permission to the directory
rm -f .vrfdir
mkdir locked
chmod 555 locked
(cd locked && "$SRCDIR/vrfdir" init)
retval=$?

if [ $retval != 3 ]; then
    echo Wrong exit value: $retval
fi

# cleanup
rm -fr .vrfdir a locked
