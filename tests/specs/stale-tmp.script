#!/bin/sh
# SPDX-FileCopyrightText: 2026 Kalle Valo
# SPDX-License-Identifier: GPL-3.0-or-later
#
# test a manifest.json.tmp left behind by an interrupted write. A write
# which fails is in tests/specs-unix and tests/specs-windows, the error
# text depends on the system.

# don't 'set -e' on purpose so that we can verify the exit value from
# the add command

cd "$DATADIR" || exit 1

"$SRCDIR/vrfdir" init
echo aaaa > a
echo bbbb > b
"$SRCDIR/vrfdir" add --quiet a

echo stale file, list warns but works
echo garbage > .vrfdir/manifest.json.tmp
"$SRCDIR/vrfdir" list

echo next write replaces the stale file
"$SRCDIR/vrfdir" add --quiet b
ls .vrfdir
"$SRCDIR/vrfdir" list

echo stale temporary file of the backup, list warns but works
echo garbage > .vrfdir/manifest.json.bak.tmp
"$SRCDIR/vrfdir" list
rm .vrfdir/manifest.json.bak.tmp

# cleanup
rm -fr .vrfdir a b
