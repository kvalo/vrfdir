#!/bin/sh
# SPDX-FileCopyrightText: 2026 Kalle Valo
# SPDX-License-Identifier: GPL-3.0-or-later
#
# test that --version and -V print the version and the environment, and
# need no repository. The values depend on the machine and change with
# every release, so only the labels are compared.

cd "$DATADIR" || exit 1

"$SRCDIR/vrfdir" --version > version.txt
echo "exit value: $?"

"$SRCDIR/vrfdir" -V > short.txt
echo "exit value of -V: $?"

if cmp -s version.txt short.txt; then
    echo "-V prints the same"
fi

if head -1 version.txt | grep -Eq '^vrfdir [0-9]+\.[0-9]+\.[0-9]+'; then
    echo "version printed"
else
    echo "wrong output: $(cat version.txt)"
fi

sed -n '/^Environment:/,$p' version.txt | sed 's/:.*//'

if [ -e .vrfdir ]; then
    echo ".vrfdir exists"
fi

# cleanup
rm -f version.txt short.txt
